# Runtime
APP_VERSION=1.0.0
SESSION_SECRET=replace-with-a-long-random-secret
ENABLE_HSTS=false
GZIP_MINIMUM_SIZE_BYTES=1000
WEB_CONCURRENCY=1
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Database and Redis
DATABASE_URL=postgresql+psycopg2://uplan:uplan@localhost:5432/uplan
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
ENABLE_NOTIFICATION_POLLER=false
NOTIFICATION_POLL_SECONDS=15

# Gateway
GATEWAY_HEALTH_TIMEOUT_SECONDS=3
BFF_TIMEOUT_SECONDS=1.5
DASHBOARD_CACHE_TTL_SECONDS=60
GATEWAY_TIMEOUT_SECONDS=15
PERF_BUDGET_SIMPLE_READ_MS=200
PERF_BUDGET_NORMAL_API_MS=500
PERF_BUDGET_HEAVY_ACK_MS=250
AUTH_SERVICE_URL=http://127.0.0.1:8009
WORKSPACE_SERVICE_URL=http://127.0.0.1:8002
PLANNING_SERVICE_URL=http://127.0.0.1:8001
TASK_ASSESSMENT_SERVICE_URL=http://127.0.0.1:8005
COLLABORATION_SERVICE_URL=http://127.0.0.1:8003
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8004

# Google OAuth / Calendar
GOOGLE_CLIENT_SECRETS_FILE=client_secret.json
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
OAUTHLIB_INSECURE_TRANSPORT=1
GOOGLE_CLIENT=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_SECRET=your-google-oauth-client-secret

# Admin
ADMIN_EMAILS=admin@example.com

# B2B payments
# Keep these server-side only. Do not expose them through VITE_* frontend env vars.
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret
STRIPE_B2B_PRICE_ID=price_replace_with_your_b2b_plan_price_id
STRIPE_SUCCESS_URL=http://localhost:5173/?payment=success
STRIPE_CANCEL_URL=http://localhost:5173/?payment=cancelled
STRIPE_CUSTOMER_PORTAL_RETURN_URL=http://localhost:5173/

# Email notifications
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=U Plan <you@example.com>

# Optional SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM=U Plan <no-reply@yourdomain.com>

# Optional media storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
