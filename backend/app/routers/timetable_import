@router.post("/extract/csv-text", response_model=TimetableExtractResponse)
def extract_timetable_from_csv_text(payload: TimetableCsvTextRequest):
    return _read_csv_text(payload.csv or "")


@router.post("/extract/image-base64", response_model=TimetableExtractResponse)
def extract_timetable_from_base64_image(payload: TimetableExtractBase64In):
    try:
        raw = base64.b64decode(payload.image_base64)
    except Exception:
        raise HTTPException(status_code=400, detail="Invalid base64 payload")
    return _read_image_bytes(raw)


@router.post("/extract/file", response_model=TimetableExtractResponse)
async def extract_timetable_from_file(file: UploadFile = File(...)):
    filename = (file.filename or "").lower()
    content_type = file.content_type or ""
    raw_bytes = await file.read()

    if content_type.startswith("image/") or filename.endswith((".png", ".jpg", ".jpeg", ".webp")):
        return _read_image_bytes(raw_bytes)

    if filename.endswith(".csv") or content_type in ("text/csv", "application/csv", "application/vnd.ms-excel"):
        try:
            raw = raw_bytes.decode("utf-8")
        except UnicodeDecodeError:
            raw = raw_bytes.decode("utf-8-sig", errors="replace")
        return _read_csv_text(raw)

    if filename.endswith((".xlsx", ".xlsm", ".xls")):
        return _read_excel_bytes(raw_bytes)

    raise HTTPException(status_code=400, detail="Unsupported file type")


@router.post("/import/preview", response_model=TimetableImportPreviewResponse)
async def import_timetable_preview(file: UploadFile = File(...)):
    extracted = await extract_timetable_from_file(file)
    normalized, errors = _normalize_extract_items(extracted.items)
    warnings: List[str] = []

    if extracted.parser and extracted.parser.startswith("ocr"):
        warnings.append("Image import may need review before saving.")
    if not normalized:
        warnings.append("No timetable rows could be extracted.")

    # Soft guard against bad OCR imports.
    distinct_titles = sorted({i.subject_title.lower() for i in normalized})
    if len(distinct_titles) > 15:
        warnings.append("A large number of distinct subjects were detected. This often means OCR noise. Please review carefully.")

    return TimetableImportPreviewResponse(items=normalized, warnings=warnings, errors=errors)


@router.post("/import/preview/csv-upload", response_model=TimetableImportPreviewResponse)
async def import_timetable_preview_csv(file: UploadFile = File(...)):
    filename = (file.filename or "").lower()
    if not filename.endswith(".csv"):
        raise HTTPException(status_code=400, detail="Expected a .csv file")
    extracted = await extract_timetable_from_file(file)
    normalized, errors = _normalize_extract_items(extracted.items)
    return TimetableImportPreviewResponse(items=normalized, warnings=[], errors=errors)


@router.post("/import/preview/excel-upload", response_model=TimetableImportPreviewResponse)
async def import_timetable_preview_excel(file: UploadFile = File(...)):
    filename = (file.filename or "").lower()
    if not filename.endswith((".xlsx", ".xlsm", ".xls")):
        raise HTTPException(status_code=400, detail="Expected an Excel file")
    extracted = await extract_timetable_from_file(file)
