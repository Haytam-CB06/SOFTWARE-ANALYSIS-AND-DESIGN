@router.post("/import-items", response_model=TimetableImportResponse)
async def import_timetable_items(
    payload: TimetableImportRequest,
    db: Session = Depends(get_db),
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    _guard_user(payload.user_id, x_user_id, db)

    normalized, errors = _normalize_extract_items(payload.items)
    result = _import_normalized_items(
        db=db,
        user_id=payload.user_id,
        items=normalized,
        create_missing_subjects=payload.create_missing_subjects,
        replace_existing=payload.replace_existing,
    )
    result.warnings.extend(errors)
    return result


@router.post("/import-and-generate", response_model=dict)
async def import_and_generate(
    payload: TimetableImportAndGenerateRequest,
    db: Session = Depends(get_db),
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    _guard_user(payload.user_id, x_user_id, db)

    normalized, errors = _normalize_extract_items(payload.items)
    import_result = _import_normalized_items(
        db=db,
        user_id=payload.user_id,
        items=normalized,
        create_missing_subjects=payload.create_missing_subjects,
        replace_existing=payload.replace_existing,
    )
    import_result.warnings.extend(errors)

    try:
        from app.routers.auto_generate import auto_generate, AutoGenerateRequest  # type: ignore
    except Exception as exc:
        return {
            "import_result": import_result.model_dump(),
            "generate_result": None,
            "warning": f"Import succeeded, but auto-generate import path must be fixed: {exc}",
        }

    generate_payload = AutoGenerateRequest(
        user_id=payload.user_id,
        window=payload.window or {
            "weekdayStart": "08:00",
            "weekdayEnd": "19:00",
            "includeWeekends": False,
            "weekendSameAsWeekday": True,
            "weekendStart": None,
            "weekendEnd": None,
        },
        busy_blocks=payload.busy_blocks,
        treat_class_schedule_as_busy=payload.treat_class_schedule_as_busy,
        use_stored_busy_blocks=payload.use_stored_busy_blocks,
        seed=payload.seed,
        shuffle=payload.shuffle,
        breakMinutes=payload.breakMinutes,
    )
    generate_result = auto_generate(generate_payload, session=db, x_user_id=x_user_id)

    return {
        "import_result": import_result.model_dump(),
        "generate_result": generate_result,
    }
