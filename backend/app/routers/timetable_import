# ---------------------------------------------------------------------
# IMPORTANT DAY CONVENTIONS
# ---------------------------------------------------------------------
# External / frontend / preview convention:
#   0 = Monday, 1 = Tuesday, ..., 6 = Sunday
#
# Database convention in ClassMeeting.day_of_week:
#   0 = Sunday, 1 = Monday, ..., 6 = Saturday
#
# The rest of your planner code already converts DB <-> frontend for class
# schedule / auto-generate, so this router should KEEP the external API on
# frontend convention and only convert at save/read boundaries.
# ---------------------------------------------------------------------

TIME_HHMM_RE = re.compile(r"^(?:[01]\d|2[0-3]):[0-5]\d$")
TIME_TOKEN_RE = re.compile(r"^\d{1,2}(?::|\.)\d{2}(?:\s*(?:am|pm))?$", re.I)
TIME_RANGE_RE = re.compile(
    r"(?P<s>\b\d{1,2}(?::|\.)\d{2}\s*(?:am|pm)?\b)\s*[-–—]\s*(?P<e>\b\d{1,2}(?::|\.)\d{2}\s*(?:am|pm)?\b)",
    re.I,
)
COURSE_CODE_RE = re.compile(r"^[A-Z]{2,6}\d{2,4}[A-Z]?$")
SECTION_RE = re.compile(r"^(CR|ROOM|RM|LAB|SEC|SECTION|BLK|BUILDING)[A-Z0-9_-]*$", re.I)

DAY_MAP = {
    "mon": 0, "monday": 0,
    "tue": 1, "tues": 1, "tuesday": 1,
    "wed": 2, "wednesday": 2,
    "thu": 3, "thur": 3, "thurs": 3, "thursday": 3,
    "fri": 4, "friday": 4,
    "sat": 5, "saturday": 5,
    "sun": 6, "sunday": 6,
}
DAY_LABELS = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]


