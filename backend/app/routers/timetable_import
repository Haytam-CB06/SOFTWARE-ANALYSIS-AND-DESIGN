    confidence: Optional[float] = None


class TimetableImportItem(BaseModel):
    day_of_week: int  # frontend convention
    start_time: str
    end_time: str
    subject_title: str
    subject_code: Optional[str] = None
    rrule: Optional[str] = None

    @field_validator("day_of_week")
    @classmethod
    def _validate_day(cls, v: int) -> int:
        if v < 0 or v > 6:
            raise ValueError("day_of_week must be between 0 and 6 (0=Mon .. 6=Sun)")
        return v

    @field_validator("start_time", "end_time")
    @classmethod
    def _validate_time(cls, v: str) -> str:
        if not TIME_HHMM_RE.match(v):
            raise ValueError("Time must be in HH:MM format")
        return v

    @field_validator("subject_title")
    @classmethod
    def _validate_subject_title(cls, v: str) -> str:
        vv = (v or "").strip()
        if not vv:
            raise ValueError("subject_title is required")
        return vv


