def _ensure_tesseract_cmd() -> None:
    if pytesseract is None:
        raise HTTPException(status_code=500, detail="pytesseract is not installed on the server.")

    current = getattr(pytesseract.pytesseract, "tesseract_cmd", "") or ""
    if current and os.path.exists(current):
        return

    import shutil
    exe = shutil.which("tesseract")
    if exe:
        pytesseract.pytesseract.tesseract_cmd = exe
        return

    candidates = [
        r"C:\Program Files\Tesseract-OCR\tesseract.exe",
        r"C:\Program Files (x86)\Tesseract-OCR\tesseract.exe",
    ]
    for p in candidates:
        if os.path.exists(p):
            pytesseract.pytesseract.tesseract_cmd = p
            return

    raise HTTPException(status_code=500, detail="Tesseract OCR is not installed or not on PATH.")


def _preprocess_image(img: Image.Image) -> Image.Image:
    img = img.convert("RGB")
    w, h = img.size
    if max(w, h) < 1600:
        scale = 2 if max(w, h) >= 900 else 3
        img = img.resize((w * scale, h * scale))
    gray = ImageOps.grayscale(img)
    gray = ImageEnhance.Contrast(gray).enhance(1.8)
    gray = ImageEnhance.Sharpness(gray).enhance(2.0)
    return gray


def _extract_items_line_based(text: str) -> List[TimetableExtractItem]:
    lines = [ln.strip() for ln in (text or "").splitlines() if ln.strip()]
    items: List[TimetableExtractItem] = []

    for ln in lines:
        day_idx, day_label = _infer_day(ln)
        m = TIME_RANGE_RE.search(ln)

        time_span = None
        start_time = end_time = None
        if m:
            try:
                start_time = _norm_time(m.group("s"))
                end_time = _norm_time(m.group("e"))
                time_span = (m.group("s"), m.group("e"))
            except Exception:
                start_time = end_time = None

        title, code = _infer_subject(ln, time_span)

        if start_time or end_time or day_idx is not None:
            items.append(
                TimetableExtractItem(
                    day_of_week=day_idx,
                    day_label=day_label,
                    start_time=start_time,
                    end_time=end_time,
                    subject_title=title,
                    subject_code=code,
                    raw_line=ln,
                    confidence=0.55,
                )
            )
    return _dedupe_items(items)


def _read_image_with_huggingface(raw_bytes: bytes) -> Optional[TimetableExtractResponse]:
    """
    Optional hook:
    - Set HF_API_TOKEN
    - Set HF_TIMETABLE_MODEL if you want a custom model endpoint

    Expected model behavior:
    return JSON-ish text or OCR text that contains timetable rows.
    """
    if InferenceClient is None:
        return None

    token = os.getenv("HF_API_TOKEN")
    model = os.getenv("HF_TIMETABLE_MODEL")
    if not token or not model:
        return None

    try:
        client = InferenceClient(token=token)
        # text-generation style fallback; many VLM endpoints are model-specific.
        # Keep this optional so the backend still works without HF.
        result = client.chat_completion(
            model=model,
            messages=[
                {
                    "role": "user",
                    "content": [
                        {"type": "text", "text": (
                            "Extract a university timetable from this image. "
                            "Return plain text lines in the format: "
                            "DAY | START-END | SUBJECT | CODE(optional). "
                            "Ignore empty cells, room-only labels, section-only labels, and decorations."
                        )},
                        {"type": "image_url", "image_url": {"url": "data:image/png;base64," + base64.b64encode(raw_bytes).decode("ascii")}},
                    ],
                }
            ],
            max_tokens=1200,
        )
        text = ""
        if getattr(result, "choices", None):
            text = result.choices[0].message.content or ""
        if not text:
            return None
        items = _extract_items_line_based(text)
        return TimetableExtractResponse(text=text, items=items, parser="huggingface")
    except Exception:
        return None


def _read_image_bytes(raw_bytes: bytes) -> TimetableExtractResponse:
    # Try optional HF parser first if configured.
    hf_result = _read_image_with_huggingface(raw_bytes)
    if hf_result and hf_result.items:
        return hf_result

    if pytesseract is None:
        raise HTTPException(status_code=500, detail="pytesseract is not installed on the server.")
    _ensure_tesseract_cmd()

    try:
        img = Image.open(io.BytesIO(raw_bytes))
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Invalid image: {e}")

    img = _preprocess_image(img)

    try:
        from pytesseract import Output  # type: ignore
        data = pytesseract.image_to_data(img, output_type=Output.DICT, config="--psm 6")
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"OCR failed: {e}")

    words: List[Dict[str, Any]] = []
    n = len(data.get("text", []))
    for i in range(n):
        raw = (data["text"][i] or "").strip()
        if not raw:
            continue
        try:
            conf = float(data["conf"][i])
        except Exception:
            conf = -1.0
        if conf < 55:
            continue

        left = int(data["left"][i]); top = int(data["top"][i]); width = int(data["width"][i]); height = int(data["height"][i])
        words.append({
            "text": raw,
            "conf": conf,
            "left": left,
            "top": top,
            "width": width,
            "height": height,
            "cx": left + width / 2.0,
            "cy": top + height / 2.0,
        })

    raw_text = " ".join(w["text"] for w in words)
    if not words:
        return TimetableExtractResponse(text="", items=[], parser="ocr")

    # Detect weekday headers
    day_headers: List[Tuple[float, int]] = []  # x_center, frontend_day
    for w in words:
        d = _day_to_int(w["text"])
        if d is not None:
            day_headers.append((w["cx"], d))

    # Detect time labels
    time_rows: List[Tuple[float, str]] = []  # y_center, HH:MM
    for w in words:
        if TIME_TOKEN_RE.match(w["text"]):
            try:
                time_rows.append((w["cy"], _norm_time(w["text"])))
            except Exception:
                continue

    # Fallback to line-based if we cannot recover a grid.
    if len(day_headers) < 2 or len(time_rows) < 2:
        try:
            text = pytesseract.image_to_string(img, config="--psm 6")
        except Exception:
            text = raw_text
        return TimetableExtractResponse(text=text, items=_extract_items_line_based(text), parser="ocr-line")

    # Merge close headers/rows
    day_headers.sort(key=lambda x: x[0])
    merged_days: List[Tuple[float, int]] = []
    for x, d in day_headers:
        if merged_days and abs(merged_days[-1][0] - x) < 40:
            continue
        merged_days.append((x, d))

    time_rows.sort(key=lambda x: x[0])
    merged_times: List[Tuple[float, str]] = []
    for y, t in time_rows:
        if merged_times and abs(merged_times[-1][0] - y) < 18:
            continue
        merged_times.append((y, t))

    if len(merged_days) < 2 or len(merged_times) < 2:
        try:
            text = pytesseract.image_to_string(img, config="--psm 6")
        except Exception:
            text = raw_text
        return TimetableExtractResponse(text=text, items=_extract_items_line_based(text), parser="ocr-line")

    # Determine header band / time column
    header_y = min(y for y, _ in merged_times)
    first_day_x = min(x for x, _ in merged_days)

    # Build row boundaries
    row_bounds: List[Tuple[float, float, str, Optional[str]]] = []
    for idx, (y, start_t) in enumerate(merged_times):
        next_y = merged_times[idx + 1][0] if idx + 1 < len(merged_times) else y + 80
        end_t = merged_times[idx + 1][1] if idx + 1 < len(merged_times) else None
        row_bounds.append((y - 18, (y + next_y) / 2.0, start_t, end_t))

    # Build col boundaries
    col_bounds: List[Tuple[float, float, int]] = []
    for idx, (x, day_idx) in enumerate(merged_days):
        next_x = merged_days[idx + 1][0] if idx + 1 < len(merged_days) else x + 180
        col_bounds.append((x - 50, (x + next_x) / 2.0, day_idx))

    items: List[TimetableExtractItem] = []
    for x0, x1, day_idx in col_bounds:
        for y0, y1, start_t, end_t in row_bounds:
            if not end_t:
                continue

            cell_words = []
            confs = []
            for w in words:
                if w["cy"] <= header_y + 8:
                    continue
                if w["left"] <= first_day_x:
                    continue
                if not (x0 <= w["cx"] < x1 and y0 <= w["cy"] < y1):
                    continue
                cell_words.append(w["text"])
                confs.append(w["conf"])

            if not cell_words:
                continue

            cell_text = re.sub(r"\s+", " ", " ".join(cell_words)).strip()
            if not cell_text:
                continue

            title, code = _infer_subject(cell_text, None)
            if not _is_meaningful_subject_title(title):
                if not (code and COURSE_CODE_RE.match(re.sub(r"[^A-Za-z0-9]", "", code).upper())):
                    continue
                title = code

            items.append(
                TimetableExtractItem(
                    day_of_week=day_idx,
                    day_label=DAY_LABELS[day_idx],
                    start_time=start_t,
                    end_time=end_t,
                    subject_title=title,
                    subject_code=code,
                    raw_line=cell_text,
                    confidence=round(sum(confs) / len(confs), 2) if confs else None,
                )
            )

    items = _dedupe_items(items)

    # Safety filter: if OCR exploded into too many rows, prefer line-based output.
    if len(items) > 60:
        try:
            text = pytesseract.image_to_string(img, config="--psm 6")
        except Exception:
            text = raw_text
        line_items = _extract_items_line_based(text)
        return TimetableExtractResponse(text=text, items=line_items, parser="ocr-line-fallback")

    return TimetableExtractResponse(text=raw_text, items=items, parser="ocr-grid")


