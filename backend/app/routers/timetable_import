@router.post("/import/preview/image-upload", response_model=TimetableImportPreviewResponse)
async def import_timetable_preview_image(file: UploadFile = File(...)):
    filename = (file.filename or "").lower()
    if not filename.endswith((".png", ".jpg", ".jpeg", ".webp")):
        raise HTTPException(status_code=400, detail="Expected an image file")
    extracted = await extract_timetable_from_file(file)
    normalized, errors = _normalize_extract_items(extracted.items)
    warnings = ["Image import may need review before saving."]
    distinct_titles = sorted({i.subject_title.lower() for i in normalized})
