def _guard_user(user_id: str, x_user_id: Optional[str], db: Session) -> User:
    if not x_user_id:
        raise HTTPException(status_code=401, detail="Missing X-User-Id header")
    if str(x_user_id) != str(user_id):
        raise HTTPException(status_code=403, detail="Forbidden")
    user = db.query(User).filter(User.id == user_id).first()
    if not user:
        raise HTTPException(status_code=404, detail="User not found")
    return user


def _frontend_day_to_backend(day: int) -> int:
    # frontend 0=Mon..6=Sun -> backend 0=Sun..6=Sat
    return (day + 1) % 7


def _backend_day_to_frontend(day: int) -> int:
    # backend 0=Sun..6=Sat -> frontend 0=Mon..6=Sun
    return (day - 1) % 7


def _norm_time(t: str) -> str:
    s = str(t or "").strip().lower().replace(".", ":")
    s = re.sub(r"\s+", "", s)

    m = re.match(r"^(\d{1,2}):(\d{2})(am|pm)?$", s)
    if not m:
        raise ValueError(f"Invalid time format: {t}")

    hh = int(m.group(1))
    mm = int(m.group(2))
    ampm = m.group(3)

    if mm < 0 or mm > 59:
        raise ValueError(f"Invalid minutes in time: {t}")

    if ampm:
        if hh < 1 or hh > 12:
            raise ValueError(f"Invalid 12-hour time: {t}")
        if ampm == "am":
            hh = 0 if hh == 12 else hh
        else:
            hh = 12 if hh == 12 else hh + 12
    else:
        if hh < 0 or hh > 23:
            raise ValueError(f"Invalid 24-hour time: {t}")

    return f"{hh:02d}:{mm:02d}"


def _parse_time_obj(value: str):
    from datetime import time
    h, m = value.split(":")
    return time(hour=int(h), minute=int(m))


def _day_to_int(val: str | int | None) -> Optional[int]:
    if val is None:
        return None
    if isinstance(val, int):
        return val if 0 <= val <= 6 else None

    s = str(val).strip()
    if not s:
        return None

    if s.isdigit():
        d = int(s)
        return d if 0 <= d <= 6 else None

    key = re.sub(r"[^a-z]", "", s.lower())
    if key in DAY_MAP:
        return DAY_MAP[key]
    if len(key) >= 3 and key[:3] in DAY_MAP:
        return DAY_MAP[key[:3]]
    return None


def _looks_like_section_or_room(value: Optional[str]) -> bool:
    if not value:
        return False
    raw = re.sub(r"[^A-Za-z0-9_-]", "", value).upper()
    return bool(SECTION_RE.match(raw))


def _is_meaningful_subject_title(value: Optional[str]) -> bool:
    if not value:
        return False

    s = re.sub(r"\s+", " ", str(value).strip())
    if not s:
        return False

    if _looks_like_section_or_room(s):
        return False

    if len(s) < 3:
        return False

    if re.fullmatch(r"[\d\W_]+", s):
        return False

    token = re.sub(r"[^A-Za-z0-9]", "", s).upper()

    weak_words = {
        "room", "lab", "section", "sec", "rm", "cr",
        "time", "day", "course", "subject", "lecture",
        "tutorial", "class", "building", "hall",
    }
    if s.lower() in weak_words:
        return False

    if len(s.split()) == 1 and not COURSE_CODE_RE.match(token):
        # allow words like Physics, Algebra, Networks
        if not re.fullmatch(r"[A-Za-z]{4,}", s):
            return False

    return True


def _clean_subject_value(title: Optional[str], code: Optional[str]) -> Tuple[Optional[str], Optional[str]]:
    title = (title or "").strip() or None
    code = (code or "").strip() or None

    if title and _looks_like_section_or_room(title):
        title = None
    if code and _looks_like_section_or_room(code):
        code = None

    if not title and code and COURSE_CODE_RE.match(re.sub(r"[^A-Za-z0-9]", "", code).upper()):
        title = code

    return title, code


def _infer_day(line: str) -> Tuple[Optional[int], Optional[str]]:
    lower = re.sub(r"[^a-z]", " ", line.lower())
    tokens = [t for t in lower.split() if t]
    for tok in tokens:
        if tok in DAY_MAP:
            return DAY_MAP[tok], tok
    return None, None


def _infer_subject(line: str, time_span: Optional[Tuple[str, str]]) -> Tuple[Optional[str], Optional[str]]:
    cleaned = line
    if time_span:
        cleaned = cleaned.replace(time_span[0], " ").replace(time_span[1], " ")

    for k in DAY_MAP.keys():
        cleaned = re.sub(rf"\b{k}\b", " ", cleaned, flags=re.I)

    cleaned = re.sub(r"\bsection\s*:?\s*[A-Za-z0-9_-]+\b", " ", cleaned, flags=re.I)
    cleaned = re.sub(r"\broom\s*:?\s*[A-Za-z0-9_-]+\b", " ", cleaned, flags=re.I)
    cleaned = re.sub(r"\s+", " ", cleaned).strip(" -|\t")

    m = re.search(r"\b([A-Z]{2,6}\s?[-]?\s?\d{2,4}[A-Z]?)\b", cleaned)
    code = None
    title = None

    if m:
        code = re.sub(r"\s+", "", m.group(1)).replace("-", "")
        title = cleaned.replace(m.group(1), "").strip(" -") or code
    else:
        title = cleaned

    title, code = _clean_subject_value(title, code)
    return title, code


def _dedupe_items(items: List[TimetableExtractItem]) -> List[TimetableExtractItem]:
    seen = set()
    out: List[TimetableExtractItem] = []
    for it in items:
        key = (
            it.day_of_week,
            it.start_time,
            it.end_time,
            (it.subject_code or it.subject_title or "").strip().lower(),
        )
        if key in seen:
            continue
        seen.add(key)
        out.append(it)
    return out


def _normalize_extract_item(it: TimetableExtractItem | TimetableImportItem) -> Tuple[Optional[TimetableImportItem], Optional[str]]:
    if isinstance(it, TimetableImportItem):
        return it, None

    if it.day_of_week is None:
        return None, f"Missing day_of_week for line: {it.raw_line or ''}"

    if not it.start_time or not it.end_time:
        return None, f"Missing time range for line: {it.raw_line or ''}"

    try:
        start_time = _norm_time(it.start_time)
        end_time = _norm_time(it.end_time)
    except Exception as e:
        return None, f"Invalid time in line '{it.raw_line or ''}': {e}"

    if start_time >= end_time:
        return None, f"start_time must be before end_time for line: {it.raw_line or ''}"

    subject_title = (it.subject_title or "").strip()
    subject_code = (it.subject_code or "").strip() or None

    if not _is_meaningful_subject_title(subject_title):
        if subject_code and COURSE_CODE_RE.match(re.sub(r"[^A-Za-z0-9]", "", subject_code).upper()):
            subject_title = subject_code
        else:
            return None, f"Rejected weak/empty subject title for line: {it.raw_line or ''}"

    return TimetableImportItem(
        day_of_week=int(it.day_of_week),
        start_time=start_time,
        end_time=end_time,
        subject_title=subject_title,
        subject_code=subject_code,
        rrule=it.rrule,
    ), None


def _normalize_extract_items(items: List[TimetableExtractItem | TimetableImportItem]) -> Tuple[List[TimetableImportItem], List[str]]:
    normalized: List[TimetableImportItem] = []
    errors: List[str] = []

    for it in items:
        norm, err = _normalize_extract_item(it)
        if err:
            errors.append(err)
            continue
        if norm:
            normalized.append(norm)

    seen = set()
    uniq: List[TimetableImportItem] = []
    for it in normalized:
        key = (it.day_of_week, it.start_time, it.end_time, (it.subject_code or it.subject_title).strip().lower())
        if key in seen:
            continue
        seen.add(key)
        uniq.append(it)

    uniq.sort(key=lambda x: (x.day_of_week, x.start_time, x.subject_title.lower()))
    return uniq, errors


