def _find_or_create_subject(
    db: Session,
    user_id: str,
    subject_title: str,
    subject_code: Optional[str],
    create_missing: bool = True,
) -> Tuple[Optional[Subject], bool]:
    query = db.query(Subject).filter(Subject.user_id == user_id)

    if subject_code:
        subject = query.filter(Subject.code == subject_code).first()
        if subject:
            return subject, False

    subject = query.filter(Subject.title == subject_title).first()
    if subject:
        return subject, False

    if not create_missing:
        return None, False

    subject = Subject(
        id=str(uuid.uuid4()),
        user_id=user_id,
        title=subject_title,
        code=subject_code,
        is_active=True,
    )
    db.add(subject)
    db.flush()
    return subject, True


def _meeting_exists(
    db: Session,
    subject_id: str,
    day_of_week_frontend: int,
    start_time: str,
    end_time: str,
) -> bool:
    backend_day = _frontend_day_to_backend(day_of_week_frontend)
    st = _parse_time_obj(start_time)
    et = _parse_time_obj(end_time)
    existing = (
        db.query(ClassMeeting)
        .filter(
            ClassMeeting.subject_id == subject_id,
            ClassMeeting.day_of_week == backend_day,
            ClassMeeting.start_time == st,
            ClassMeeting.end_time == et,
        )
        .first()
    )
    return existing is not None


def _import_normalized_items(
    db: Session,
    user_id: str,
    items: List[TimetableImportItem],
    *,
    create_missing_subjects: bool = True,
    replace_existing: bool = False,
) -> TimetableImportResponse:
    created_subjects = 0
    reused_subjects = 0
    created_meetings = 0
    skipped_items = 0
    warnings: List[str] = []

    if len(items) > 100:
        raise HTTPException(status_code=400, detail="Too many timetable rows detected. Please review the import preview.")

    if replace_existing:
        subject_ids = [s.id for s in db.query(Subject).filter(Subject.user_id == user_id).all()]
        if subject_ids:
            db.query(ClassMeeting).filter(ClassMeeting.subject_id.in_(subject_ids)).delete(synchronize_session=False)

    seen_subjects: set[str] = set()

    for item in items:
        subject, created = _find_or_create_subject(
            db=db,
            user_id=user_id,
            subject_title=item.subject_title,
            subject_code=item.subject_code,
            create_missing=create_missing_subjects,
        )

        if not subject:
            skipped_items += 1
            warnings.append(f"Skipped '{item.subject_title}' because subject does not exist")
            continue

        subj_key = f"{getattr(subject, 'title', '')}|{getattr(subject, 'code', '')}"
        seen_subjects.add(subj_key)

        if created:
            created_subjects += 1
        else:
            reused_subjects += 1

        if _meeting_exists(
            db=db,
            subject_id=str(subject.id),
            day_of_week_frontend=item.day_of_week,
            start_time=item.start_time,
            end_time=item.end_time,
        ):
            skipped_items += 1
            warnings.append(
                f"Duplicate skipped: {item.subject_title} day={item.day_of_week} {item.start_time}-{item.end_time}"
            )
            continue

        meeting = ClassMeeting(
            id=str(uuid.uuid4()),
            subject_id=subject.id,
            day_of_week=_frontend_day_to_backend(item.day_of_week),
            start_time=_parse_time_obj(item.start_time),
            end_time=_parse_time_obj(item.end_time),
            rrule=item.rrule,
        )
        db.add(meeting)
        created_meetings += 1

    # If an image import somehow created an absurd number of distinct courses, roll back instead of polluting DB.
    if len(seen_subjects) > 20:
        db.rollback()
        raise HTTPException(
            status_code=400,
            detail="Import looks incorrect: too many distinct courses were detected. Please review the preview before saving.",
        )

    db.commit()

    return TimetableImportResponse(
        created_subjects=created_subjects,
        reused_subjects=reused_subjects,
        created_meetings=created_meetings,
        skipped_items=skipped_items,
        warnings=warnings,
    )


