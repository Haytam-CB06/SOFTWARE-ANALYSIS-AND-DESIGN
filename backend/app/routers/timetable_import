# Excel parsing
# ---------------------------------------------------------------------

def _cell_text(v: Any) -> str:
    if v is None:
        return ""
    return str(v).strip()


def _parse_row_excel(ws) -> List[TimetableExtractItem]:
    rows = list(ws.iter_rows(values_only=True))
    if not rows:
        return []

    header = [str(v or "").strip().lower() for v in rows[0]]
    if not header:
        return []

    def find_idx(*names: str) -> Optional[int]:
        for candidate in names:
            if candidate in header:
                return header.index(candidate)
        return None

    day_idx = find_idx("day", "weekday", "day_of_week")
    start_idx = find_idx("start", "start_time", "starttime")
    end_idx = find_idx("end", "end_time", "endtime")
    subject_idx = find_idx("subject", "title", "course", "name", "course_title")
    code_idx = find_idx("subject_code", "code", "course_code")

    if day_idx is None or start_idx is None or end_idx is None or subject_idx is None:
        return []

    items: List[TimetableExtractItem] = []
    for row in rows[1:]:
        values = list(row)
        items.append(
            TimetableExtractItem(
                day_of_week=_day_to_int(values[day_idx] if day_idx < len(values) else None),
                day_label=_cell_text(values[day_idx] if day_idx < len(values) else None),
                start_time=_cell_text(values[start_idx] if start_idx < len(values) else None) or None,
                end_time=_cell_text(values[end_idx] if end_idx < len(values) else None) or None,
                subject_title=_cell_text(values[subject_idx] if subject_idx < len(values) else None) or None,
                subject_code=_cell_text(values[code_idx] if code_idx is not None and code_idx < len(values) else None) or None,
                raw_line=" | ".join([_cell_text(v) for v in values]),
                confidence=1.0,
            )
        )
    return items


def _parse_grid_excel(ws) -> List[TimetableExtractItem]:
    rows = list(ws.iter_rows(values_only=True))
    if not rows:
        return []

    header_idx = None
    header_days: Dict[int, int] = {}
    for i, row in enumerate(rows[:10]):
        day_hits = {}
        for col_idx, val in enumerate(row):
            d = _day_to_int(_cell_text(val))
            if d is not None:
                day_hits[col_idx] = d
        if len(day_hits) >= 2:
            header_idx = i
            header_days = day_hits
            break

    if header_idx is None:
        return []

    time_col = 0
    first_day_col = min(header_days.keys())
    for c in range(0, first_day_col + 1):
        sample_hits = 0
        for r in range(header_idx + 1, min(header_idx + 12, len(rows))):
            txt = _cell_text(rows[r][c] if c < len(rows[r]) else "")
            if TIME_TOKEN_RE.match(txt):
                sample_hits += 1
        if sample_hits >= 2:
            time_col = c
            break

    items: List[TimetableExtractItem] = []
    for r in range(header_idx + 1, len(rows)):
        row = rows[r]
        start_raw = _cell_text(row[time_col] if time_col < len(row) else "")
        if not start_raw:
            continue
        try:
            start_norm = _norm_time(start_raw)
        except Exception:
            continue

        end_norm = None
        for rr in range(r + 1, len(rows)):
            nxt = _cell_text(rows[rr][time_col] if time_col < len(rows[rr]) else "")
            if not nxt:
                continue
            try:
                end_norm = _norm_time(nxt)
                break
            except Exception:
                continue

        if not end_norm or end_norm <= start_norm:
            continue

        for col_idx, day_idx in header_days.items():
            if col_idx >= len(row):
                continue
            cell = _cell_text(row[col_idx])
            if not cell:
                continue

            title, code = _infer_subject(cell, None)
            if not title:
                continue

            items.append(
                TimetableExtractItem(
                    day_of_week=day_idx,
                    day_label=DAY_LABELS[day_idx],
                    start_time=start_norm,
                    end_time=end_norm,
                    subject_title=title,
                    subject_code=code,
                    raw_line=cell,
                    confidence=1.0,
                )
            )

    return items


def _read_excel_bytes(raw_bytes: bytes) -> TimetableExtractResponse:
    try:
        wb = load_workbook(io.BytesIO(raw_bytes), data_only=True)
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Invalid Excel file: {e}")

    all_items: List[TimetableExtractItem] = []
    text_parts: List[str] = []

    for ws in wb.worksheets:
        row_items = _parse_row_excel(ws)
        grid_items = _parse_grid_excel(ws)

        items = row_items if len(row_items) >= len(grid_items) else grid_items
        all_items.extend(items)

        for row in ws.iter_rows(values_only=True):
            text_parts.append(" | ".join(_cell_text(v) for v in row if _cell_text(v)))

    return TimetableExtractResponse(
        text="\n".join([p for p in text_parts if p]),
        items=_dedupe_items(all_items),
        parser="excel",
    )


